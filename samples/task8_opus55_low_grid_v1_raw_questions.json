                "parts": [
                  {
                    "type": "text",
                    "value": "Area "
                  },
                  {
                    "type": "math",
                    "value": "=(\u221a3+1)(\u221a3-1)=3-1=2"
                  },
                  {
                    "type": "text",
                    "value": " square units"
                  }
                ],
                "tick_label": "area",
                "tick_count": 1
              }
